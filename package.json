{
  "name": "@amjadiqbal/firebase-auth-tanstack-start",
  "version": "0.1.1",
  "description": "Firebase Authentication for TanStack Start: httpOnly session cookies, a typed user on the server for SSR, server functions and routes, login/logout routes, a beforeLoad guard and a React hook. Verifies tokens with Web Crypto (no firebase-admin needed) or through firebase-admin. Community package, not affiliated with Google.",
  "keywords": [
    "firebase",
    "firebase-auth",
    "firebase-authentication",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "session-cookie",
    "ssr",
    "authentication",
    "jwt",
    "app-check",
    "react"
  ],
  "homepage": "https://github.com/amjadiqbal/firebase-auth-tanstack-start#readme",
  "bugs": "https://github.com/amjadiqbal/firebase-auth-tanstack-start/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/firebase-auth-tanstack-start.git"
  },
  "license": "MIT",
  "author": {
    "name": "Amjad Iqbal",
    "url": "https://amjad.com.pk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "firebase": ">=11",
    "firebase-admin": ">=12",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@peculiar/x509": "2.2.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.5.2",
    "@types/react": "19.3.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "jsdom": "30.1.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
